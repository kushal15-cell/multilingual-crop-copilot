ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./artifacts/review_queue.sqlite3
REVIEWER_API_KEY=change-this-before-sharing-the-reviewer-service
API_BASE_URL=http://localhost:8000

# Vision artifacts produced by training
CV_CHECKPOINT=artifacts/cv/best_model.pt
CV_CLASS_NAMES=artifacts/cv/class_names.json
CV_ABSTAIN_THRESHOLD=0.65
CV_REVIEW_THRESHOLD=0.80

# Price model produced by training
PRICE_MODEL_PATH=artifacts/price/price_forecaster.joblib
MARKET_DATA_PATH=data/processed/market_prices.csv

# Open-Meteo works without an API key
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast

# Optional OpenAI-compatible LLM. If absent, a deterministic safe template is used.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# Optional speech providers
WHISPER_MODEL_SIZE=base
TTS_PROVIDER=gtts

# Never enable outside a local UI demo. It does not diagnose a real image.
ALLOW_DEMO_CLASSIFIER=false
